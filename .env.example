# =====================================================================
#  LEAD NEXT Q&A  -  SECRETS.  Never commit or share the real values.
#  Local:  copy this file to  .env.local  and fill it in.
#  Vercel: Project > Settings > Environment Variables (add the same names),
#          then click Redeploy (changes only apply to NEW deployments).
#  No quotes, no spaces around the = sign.
# =====================================================================

# Supabase > top bar "Connect" > "Transaction pooler" (port 6543). Do NOT use the
# "Direct connection" (it is IPv6-only and fails on Vercel).
# Replace [YOUR-PASSWORD]. Use a DB password with only letters+numbers.
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Password you type at /admin (min 6 characters). There is NO default password.
ADMIN_PASSWORD=

# Any long random text (signs the admin login cookie). e.g. run: openssl rand -hex 32
SESSION_SECRET=

# Optional: final site address used inside the QR code (leave empty to auto-detect)
NEXT_PUBLIC_SITE_URL=
